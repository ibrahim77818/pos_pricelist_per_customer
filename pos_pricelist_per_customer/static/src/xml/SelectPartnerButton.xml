<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 20 templates reference component data through `this.` (this.pos, this.props, this.ui). -->
    <t t-name="pos_pricelist_per_customer.SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]" position="inside">
            <t t-set="ppcOrder" t-value="this.pos.getOrder()"/>
            <!-- only when the button shows the current order's customer: never next to another
                 order's customer (the refund-screen bug fixed in 16.0); icon-only button on small screens -->
            <div t-if="!this.ui.isSmall and ppcOrder and ppcOrder._ppcEnabled() and ppcOrder.pricelist_id and this.props.partner?.id === ppcOrder.getPartner()?.id"
                 class="ppc-pricelist-badge"
                 t-att-class="{'ppc-pricelist-customer': ppcOrder.pricelist_source === 'customer'}"
                 t-att-title="ppcOrder.getPricelistSourceLabel()">
                <i class="fa fa-tags" role="img" aria-label="Pricelist" title="Pricelist"/>
                <span class="ppc-pricelist-name" t-out="ppcOrder.pricelist_id.display_name"/>
            </div>
        </xpath>
    </t>
</templates>
