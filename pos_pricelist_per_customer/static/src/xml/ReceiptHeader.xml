<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_pricelist_per_customer.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('cashier')]" position="after">
            <div t-if="props.data.ppc_pricelist_name" class="ppc-receipt-pricelist">
                Pricelist: <t t-esc="props.data.ppc_pricelist_name"/>
            </div>
        </xpath>
    </t>
</templates>
