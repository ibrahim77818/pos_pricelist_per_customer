#. module: pos_pricelist_per_customer
#: model:ir.model.fields,help:pos_pricelist_per_customer.field_res_partner__pos_assigned_pricelist_id
#: model:ir.model.fields,help:pos_pricelist_per_customer.field_res_users__pos_assigned_pricelist_id
msgid "Pricelist explicitly assigned to this customer (or to its company) for the current company. Unlike the standard 'Pricelist' field, it ignores the generic fallback and country-group pricelists, and inactive pricelists."
msgstr "قائمة الأسعار المعيّنة صراحةً لهذا العميل (أو لشركته) في الشركة الحالية. بخلاف حقل 'قائمة الأسعار' القياسي، فهو يتجاهل قائمة الأسعار الاحتياطية العامة وقوائم أسعار مجموعات الدول وقوائم الأسعار غير النشطة."

