#. module: pos_pricelist_per_customer
#: model:ir.model.fields,help:pos_pricelist_per_customer.field_pos_config__auto_customer_pricelist
#: model:ir.model.fields,help:pos_pricelist_per_customer.field_res_config_settings__pos_auto_customer_pricelist
msgid "When a customer is selected on an order, automatically apply the pricelist assigned to that customer (if it is available in this Point of Sale). Orders without a customer, or with a customer without an assigned pricelist, use the default pricelist of this Point of Sale."
msgstr "عند اختيار عميل في الطلب، تُطبَّق قائمة الأسعار المعيّنة لهذا العميل تلقائيًا (إذا كانت متاحة في نقطة البيع هذه). الطلبات بدون عميل، أو مع عميل ليست له قائمة أسعار معيّنة، تستخدم قائمة الأسعار الافتراضية لنقطة البيع هذه."
