<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_pricelist_per_customer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_pricelist_per_customer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='multiple_prices_setting']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="auto_customer_pricelist_setting"
                     attrs="{'invisible': [('pos_use_pricelist', '=', False)]}">
                    <div class="o_setting_left_pane">
                        <field name="pos_auto_customer_pricelist"
                               attrs="{'readonly': [('pos_has_active_session', '=', True)]}"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_auto_customer_pricelist" string="Automatic Customer Pricelist"/>
                        <div class="text-muted">
                            Apply the pricelist assigned to the selected customer; fall back to the default pricelist otherwise.
                        </div>
                        <div class="content-group mt16"
                             attrs="{'invisible': [('pos_auto_customer_pricelist', '=', False)]}">
                            <div>
                                <field name="pos_receipt_show_pricelist" class="oe_inline"/>
                                <label for="pos_receipt_show_pricelist" string="Show Pricelist on Receipt" class="o_light_label"/>
                            </div>
                            <div class="text-muted mt8">
                                Only pricelists available in this Point of Sale are applied. Inactive or unavailable customer pricelists fall back to the default pricelist.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
