<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_pricelist_per_customer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_pricelist_per_customer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='multiple_prices_setting']" position="after">
                <setting id="auto_customer_pricelist_setting"
                         string="Automatic Customer Pricelist"
                         help="Apply the pricelist assigned to the selected customer; fall back to the default pricelist otherwise."
                         invisible="not pos_use_pricelist">
                    <field name="pos_auto_customer_pricelist" readonly="pos_has_active_session"/>
                    <div class="content-group" invisible="not pos_auto_customer_pricelist">
                        <div class="mt16">
                            <field name="pos_receipt_show_pricelist" class="oe_inline"/>
                            <label for="pos_receipt_show_pricelist" string="Show Pricelist on Receipt" class="o_light_label"/>
                        </div>
                        <div class="text-muted mt8">
                            Only pricelists available in this Point of Sale are applied. Inactive or unavailable customer pricelists fall back to the default pricelist.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
